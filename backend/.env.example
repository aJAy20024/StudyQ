# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/studyquest
# Or MongoDB Atlas (recommended for free cloud hosting):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studyquest

# Secret used to sign login tokens - change this to any random long string
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the server runs on
PORT=5000
